+def _file_refs(value: object) -> tuple[G2LexFileRef, ...]:
+    if value is None:
+        return ()
+    values = (value,) if isinstance(value, (str, Path, G2LexFileRef, Mapping)) else value
+    if not isinstance(values, Sequence):
